{
	"name": "handelce/wp-doctor",
	"description": "Read-only health and compromise scanner for WordPress. Point it at a site directory and get a ranked report of what is slow, bloated, misconfigured, or compromised, with a fix for every finding.",
	"type": "library",
	"license": "MIT",
	"homepage": "https://github.com/handelce/wp-doctor",
	"support": {
		"issues": "https://github.com/handelce/wp-doctor/issues",
		"source": "https://github.com/handelce/wp-doctor",
		"security": "https://github.com/handelce/wp-doctor/security/policy"
	},
	"keywords": [
		"wordpress",
		"security",
		"performance",
		"diagnostics",
		"malware",
		"cli"
	],
	"authors": [
		{
			"name": "Handel Emezue",
			"homepage": "https://github.com/handelce"
		}
	],
	"require": {
		"php": ">=7.2",
		"ext-json": "*",
		"ext-mysqli": "*"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"justinrainbow/json-schema": "^5.3",
		"phpcompatibility/php-compatibility": "^9.3",
		"phpstan/phpstan": "^1.11",
		"phpunit/phpunit": "^8.5 || ^9.6",
		"seld/phar-utils": "^1.2",
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"suggest": {
		"ext-curl": "Fetches the core checksums when allow_url_fopen is disabled"
	},
	"autoload": {
		"classmap": [
			"src/"
		],
		"files": [
			"src/functions.php"
		]
	},
	"autoload-dev": {
		"classmap": [
			"tests/"
		]
	},
	"bin": [
		"bin/wp-doctor"
	],
	"scripts": {
		"build": "@php -d phar.readonly=0 tools/build-phar.php",
		"lint": "find src bin tools tests -path tests/fixtures -prune -o -name '*.php' -print0 | xargs -0 -n1 php -l && php -l bin/wp-doctor",
		"cs": "phpcs",
		"analyse": [
			"@composer dump-autoload",
			"phpstan analyse --memory-limit=512M"
		],
		"test": [
			"@composer dump-autoload",
			"phpunit"
		]
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "7.2.34"
		}
	}
}
