# Follows the .editorconfig of WordPress core (wordpress-develop).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.yml]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Composer writes the lock file itself, with four spaces.
[composer.lock]
indent_style = space
indent_size = 4
